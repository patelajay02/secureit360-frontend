# SecureIT360 frontend environment (placeholders only — never commit real values)
# Copy to .env.local for dev; set the real values in the Vercel project settings.
# Only NEXT_PUBLIC_* values are exposed to the browser — never put a secret here.

NEXT_PUBLIC_API_URL=https://api.secureit360.co
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key   # public site key (safe)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx    # publishable key (safe)
NEXT_PUBLIC_AZURE_CLIENT_ID=your-azure-app-client-id     # public client id (safe)
