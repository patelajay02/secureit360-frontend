# SecureIT360 backend environment (placeholders only — never commit real values)
# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key   # server-only; bypasses RLS
SUPABASE_PAT=your-supabase-personal-access-token       # management API; server-only

# --- Email (SendGrid) ---
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=hello@secureit360.co

# --- Billing (Stripe) ---
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx                        # required for webhook verification

# --- reCAPTCHA (server-side verification) ---
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# --- Scanning API keys (optional; scans that need them skip if unset) ---
SHODAN_API_KEY=
HIBP_API_KEY=
ANTHROPIC_API_KEY=                                     # SaaS connector setup-wizard only

# --- Threat intelligence (optional) ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=

# --- OAuth integrations (optional) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
FRONTEND_URL=https://secureit360.co

# --- Scheduler tuning (optional) ---
DAILY_SCAN_TIMEOUT_SECONDS=600
MAX_CONCURRENT_TENANT_SCANS=3
